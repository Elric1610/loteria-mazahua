---
import "../styles/global.css";

interface Props {
  title?: string;
  bodyClass?: string;
  noindex?: boolean;
}
const { title = "Lotería Mazahua", bodyClass = "view-menu", noindex = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#8f3a27" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,900&family=Lilita+One&family=Nunito:wght@700;800;900&display=swap"
    />
    <link rel="icon" href="data:," />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
